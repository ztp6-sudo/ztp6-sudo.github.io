<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Zachary Pyskaty | Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f6f8;
            color: #1f2937;
            line-height: 1.6;
        }

        nav {
            background-color: #172554;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 8%;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav h2 {
            font-size: 22px;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 28px;
        }

        nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover {
            color: #93c5fd;
        }

        .hero {
            min-height: 85vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 60px 20px;
            background: linear-gradient(135deg, #172554, #1e3a8a);
            color: white;
        }

        .hero-content {
            max-width: 850px;
        }

        .hero h1 {
            font-size: 56px;
            margin-bottom: 10px;
        }

        .hero h2 {
            font-size: 25px;
            font-weight: normal;
            color: #bfdbfe;
            margin-bottom: 25px;
        }

        .hero p {
            font-size: 20px;
            margin-bottom: 30px;
        }

        .button {
            display: inline-block;
            padding: 12px 24px;
            margin: 8px;
            background-color: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 7px;
            font-weight: bold;
            transition: 0.3s;
        }

        .button:hover {
            background-color: #1d4ed8;
            transform: translateY(-2px);
        }

        .button-secondary {
            background: transparent;
            border: 2px solid white;
        }

        .button-secondary:hover {
            background-color: white;
            color: #172554;
        }

        section {
            padding: 80px 10%;
        }

        section h2 {
            text-align: center;
            font-size: 36px;
            color: #172554;
            margin-bottom: 15px;
        }

        .section-description {
            text-align: center;
            max-width: 750px;
            margin: 0 auto 45px;
            color: #6b7280;
        }

        .about {
            background-color: white;
        }

        .about-content {
            max-width: 850px;
            margin: auto;
            text-align: center;
            font-size: 18px;
        }

        .skills {
            background-color: #f4f6f8;
        }

        .skills-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            max-width: 950px;
            margin: auto;
        }

        .skill {
            background-color: white;
            padding: 14px 20px;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            font-weight: bold;
            transition: 0.3s;
        }

        .skill:hover {
            transform: translateY(-4px);
        }

        .projects {
            background-color: white;
        }

        .projects-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            max-width: 1100px;
            margin: auto;
        }

        .project-card {
            background-color: #f8fafc;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.08);
            border-top: 4px solid #2563eb;
            transition: 0.3s;
        }

        .project-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }

        .project-card h3 {
            margin-bottom: 15px;
            color: #1d4ed8;
            font-size: 22px;
        }

        .project-card p {
            color: #4b5563;
        }

        .experience {
            background-color: #f4f6f8;
        }

        .experience-container {
            max-width: 900px;
            margin: auto;
        }

        .experience-item {
            background-color: white;
            padding: 25px;
            margin-bottom: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.06);
        }

        .experience-item h3 {
            color: #172554;
            margin-bottom: 5px;
        }

        .experience-item h4 {
            color: #2563eb;
            font-weight: normal;
            margin-bottom: 12px;
        }

        .contact {
            background-color: #172554;
            color: white;
            text-align: center;
        }

        .contact h2 {
            color: white;
        }

        .contact p {
            margin-bottom: 20px;
        }

        footer {
            background-color: #0f172a;
            color: #cbd5e1;
            text-align: center;
            padding: 20px;
        }

        @media (max-width: 700px) {
            nav {
                flex-direction: column;
                gap: 12px;
            }

            nav ul {
                gap: 14px;
                font-size: 14px;
            }

            .hero h1 {
                font-size: 40px;
            }

            .hero h2 {
                font-size: 21px;
            }

            .hero p {
                font-size: 17px;
            }

            section {
                padding: 60px 7%;
            }
        }
    </style>
</head>

